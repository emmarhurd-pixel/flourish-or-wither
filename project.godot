;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Flourish or Wither"
run/main_scene="uid://bqcoy32wnf0tg"
config/features=PackedStringArray("4.6", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

Dialogic="*uid://ds2q0uclmolvu"

[dialogic]

directories/dch_directory={
"Captain": "res://characters/Captain.dch",
"Chef": "res://characters/Chef.dch",
"DockMaster": "res://characters/DockMaster.dch",
"Fisherman": "res://characters/Fisherman.dch",
"ReefDiver": "res://characters/ReefDiver.dch",
